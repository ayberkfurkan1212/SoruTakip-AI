# Vercel → Project Settings → Environment Variables bölümünde tanımlanır.
# Bu dosya yalnızca örnektir; gerçek değerleri repoya koymayın.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Yapay zekâ
ANTHROPIC_API_KEY=

# Rate limit ve AI kotası
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-posta ve bildirim
RESEND_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Oturum ve zamanlanmış görevler
VELI_OTURUM_SECRET=
CRON_SECRET=

# Ödeme (Shopier)
SHOPIER_API_KEY=
SHOPIER_API_SECRET=

NEXT_PUBLIC_SITE_URL=https://sorutakip.online
